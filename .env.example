# Copy to .env.local (gitignored) for local dev. CI reads these from GitHub repo variables/secrets.
# Only the PUBLIC anon key goes in the app. NEVER put the service_role key here or anywhere in this repo.
# Leave empty to run fully offline/solo (no sign-in, no sync).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
